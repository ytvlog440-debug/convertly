# Convertly V2 - Environment Configuration

PROJECT_NAME="Convertly V2"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & CORS
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://convertly.app"

# Database Configuration (PostgreSQL for prod, SQLite async for local dev)
DATABASE_URL="sqlite+aiosqlite:///./convertly.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://convertly:password@postgres:5432/convertly_db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# File Storage Configuration
# Driver options: "local" | "s3_r2"
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./storage_data"

# Cloudflare R2 / AWS S3 Configuration (Optional if STORAGE_DRIVER=s3_r2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="convertly-files"
R2_ENDPOINT_URL=""

# Retention & Limits
MAX_UPLOAD_SIZE_MB=100
FILE_RETENTION_MINUTES=120
RATE_LIMIT_PER_MINUTE=60
