{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "convertly",
  "main": "worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "convertlytools.xyz",
      "custom_domain": true
    }
  ]
}
